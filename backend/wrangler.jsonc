// The class backend: a Cloudflare Worker with a D1 database. See the README for setup.
// Pushing changes under backend/ to main deploys it (.github/workflows/deploy-backend.yml).
{
  "name": "python-exercises-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "python-exercises-backend",
      "database_id": "1d928043-372e-4b46-aeba-6c6ca7712286",
      "migrations_dir": "migrations"
    }
  ]
}
